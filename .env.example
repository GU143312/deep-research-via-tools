# Copy to .env. Never commit .env or paste API keys into chat.
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEFAULT_MODEL_NAME=deepseek-flash
# Optional OpenAI fallback: MODEL_PROVIDER=openai and DEFAULT_MODEL_NAME=gpt-5.4-mini
OPENAI_API_KEY=
HOW_MANY_SEARCHES=5
# Keep false for DeepSeek; local tool events are saved in workflow.json.
ENABLE_TRACING=false

# Only needed when selecting real email delivery. Default is local preview.
# QQ: enable SMTP and generate an authorization code in mailbox settings.
# Port 465 uses implicit SSL/TLS; port 587 requires STARTTLS.
# See docs/EMAIL_SETUP.md for QQ, Gmail and Microsoft 365 instructions.
EMAIL_SMTP_SERVER=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Recipient and send/preview selection are entered in the UI for each run.
