# Required
DEEPSEEK_API_KEY=sk-your-deepseek-key
TAVILY_API_KEY=tvly-your-key

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
RESEARCH_SEARCH_COUNT=5
RESEARCH_MAX_RESULTS=5

# Optional email delivery through a NetEase mailbox.
# Use a client authorization code, NEVER your normal mailbox password.
# NETEASE_EMAIL=your-name@163.com
# NETEASE_AUTH_CODE=your-client-authorization-code
# EMAIL_TO=recipient@example.com
# NETEASE_SMTP_HOST=smtp.163.com
# NETEASE_SMTP_PORT=465

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your-key
# LANGSMITH_PROJECT=langgraph-deep-research

